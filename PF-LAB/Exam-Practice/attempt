void doubled(int *n){
  *n = *n * 2;
}

int main(){
  int n = 5;

  doubled(&n);
  printf("%d", n);

}

3.2 #include <stdio.h>

void swap(int *a, int *b){
  int temp = *b;
  *b = *a;
  *a = temp;
}

int main(){
  int x=6, y=7;

  printf("original: %d %d", x, y);
  swap(&x, &y);
  printf("\nswaped: %d %d", x, y);

  return 0;
}

